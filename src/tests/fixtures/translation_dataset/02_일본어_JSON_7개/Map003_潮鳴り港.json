{"displayName":"潮鳴り港・夜","tilesetId":3,"width":34,"height":22,"scrollType":0,"events":[null,{"id":1,"name":"EV001_港の案内人","x":7,"y":3,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["案内人アオイ",0,0,2,""]},{"code":401,"indent":0,"parameters":["ようこそ、潮鳴り港へ。今夜は霧が深いから、灯台の鐘だけを頼りに歩くといい。"]},{"code":401,"indent":0,"parameters":["さっき東の桟橋で、誰も乗っていない渡し船が戻ってきたんだ。船底はまだ温かかったよ。"]},{"code":401,"indent":0,"parameters":["地図には載っていない水路がある。満潮のときだけ、古い石段の先に入口が現れるらしい。"]},{"code":401,"indent":0,"parameters":["町長に会うなら先に通行証を取っておくれ。名前の欄は\\N[1]で間違いないかい？"]},{"code":0,"indent":0,"parameters":[]}]}]},{"id":2,"name":"EV002_夜警の詰所","x":14,"y":6,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["夜警レン",0,0,2,""]},{"code":401,"indent":0,"parameters":["巡回記録、二十二時三十分。異常なし、と書くつもりだったが、運河で青い灯を見た。"]},{"code":401,"indent":0,"parameters":["あの光を追った隊員が一人、靴だけを残して消えた。冗談として片づけるには早すぎる。"]},{"code":401,"indent":0,"parameters":["通行証があれば検問は通せる。ただし封鎖区画の鍵は司令室で管理している。"]},{"code":401,"indent":0,"parameters":["噂と証拠を混ぜるな。調べた時刻と目撃者の名前を、必ず別々に記録するんだ。"]},{"code":0,"indent":0,"parameters":[]}]}]},{"id":3,"name":"EV003_波止場の魚屋","x":21,"y":9,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["魚屋ミツ",0,0,2,""]},{"code":401,"indent":0,"parameters":["今日の漁は妙だったね。網にかかった魚が、みんな同じ方向を向いて動かなかった。"]},{"code":401,"indent":0,"parameters":["それでも塩焼きなら三十ゴールドだよ。\\V[4]個買うなら、おまけの香草をつけよう。"]},{"code":401,"indent":0,"parameters":["最近は海水の味が薄いんだ。沖合の黒い塔が動き始めたせいだって船長は言ってた。"]},{"code":401,"indent":0,"parameters":["私の祖父は潮の音で天気を当てた。けれど今夜の海は、まるで人の声みたいに聞こえる。"]},{"code":0,"indent":0,"parameters":[]}]}]},{"id":4,"name":"EV004_壊れた時計台","x":28,"y":12,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["時計職人セナ",0,0,2,""]},{"code":401,"indent":0,"parameters":["時計台は三日前から十一時五十九分で止まっている。歯車を替えても針が戻るんだ。"]},{"code":401,"indent":0,"parameters":["地下から微かな振動が伝わってくる。原因は機械ではなく、この場所そのものかもしれない。"]},{"code":401,"indent":0,"parameters":["真鍮の小歯車が手に入れば、もう一度試せる。修理の報酬は古い懐中時計でどうかな。"]},{"code":401,"indent":0,"parameters":["針が逆回転したらすぐ離れて。以前その瞬間に、窓の外の雨だけが止まったんだ。"]},{"code":102,"indent":0,"parameters":[["詳しく聞く","あとで戻る"],-2,0,2,0]},{"code":402,"indent":0,"parameters":[0,"詳しく聞く"]},{"code":401,"indent":1,"parameters":["聞きたいことがあるなら、記録を一緒に確認しよう。噂のままでは誰も守れない。"]},{"code":402,"indent":0,"parameters":[1,"あとで戻る"]},{"code":401,"indent":1,"parameters":["わかった。霧が晴れたら、もう一度ここに来てくれ。"]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}]}]},{"id":5,"name":"EV005_宿屋の受付","x":4,"y":15,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["宿屋主人ユイ",0,0,2,""]},{"code":401,"indent":0,"parameters":["お帰りなさい。二階の角部屋は空いていますが、夜明けまでは窓を開けないでください。"]},{"code":401,"indent":0,"parameters":["廊下の足音が聞こえても、扉を開けないこと。客室の数より足音が多い夜があるんです。"]},{"code":401,"indent":0,"parameters":["宿泊料金は一泊\\V[8]ゴールドです。代金を支払えば、仲間全員の体力が回復します。"]},{"code":401,"indent":0,"parameters":["忘れ物箱には宛名のない手紙が山ほどあります。どれも同じ筆跡で「待っている」と。"]},{"code":0,"indent":0,"parameters":[]}]}]},{"id":6,"name":"EV006_船大工の倉庫","x":11,"y":18,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["船大工ガク",0,0,2,""]},{"code":401,"indent":0,"parameters":["木材が海水を吸って黒くなるなんて聞いたことがない。しかも乾かすと元の色に戻る。"]},{"code":401,"indent":0,"parameters":["この船の銘板には、まだ建造されていない来年の日付が刻まれているんだ。"]},{"code":401,"indent":0,"parameters":["工具を触るなら手袋を使え。青銅の釘に指を切ると、一晩中あの塔の夢を見る。"]},{"code":401,"indent":0,"parameters":["修理した帆には風を集める縫い目がある。北風が吹かなくても船を進められるはずだ。"]},{"code":0,"indent":0,"parameters":[]}]}]},{"id":7,"name":"EV007_灯台守の小屋","x":18,"y":2,"pages":[{"conditions":{"switch1Valid":false,"variableValid":false},"trigger":0,"priorityType":1,"list":[{"code":101,"indent":0,"parameters":["灯台守ナギ",0,0,2,""]},{"code":401,"indent":0,"parameters":["灯台の火を消してはいけない。海図より古い約束が、ここには残っている。"]},{"code":401,"indent":0,"parameters":["三度点滅したら友好的な船、二度なら遭難者、七度なら……見なかったことにしてほしい。"]},{"code":401,"indent":0,"parameters":["油の残量は\\V[12]だ。次の補給船が来るまで、無駄に燃やすわけにはいかない。"]},{"code":401,"indent":0,"parameters":["灯台の最上階から見える水平線は、夜だけ少し湾曲して見えるんだ。"]},{"code":0,"indent":0,"parameters":[]}]}]}]}