# =========================================================
#  LLM 로컬 환경 — Git 무시 목록
#  민감 정보·대용량 파일·로그·캐시를 저장소에서 제외합니다.
# =========================================================

# ─────────────────────────────────────────────
#  설치된 환경 전체 (대용량 + 사용자별)
# ─────────────────────────────────────────────
# 14GB+ 의 모델 데이터, 컨테이너, venv 등
# 코드만 저장소에 두고 환경은 `python -m installer` 로 재생성
#
# Windows 에서는 이 전부가 C:\LocalAI 아래에 있어 체크아웃에는 생기지 않는다.
# 아래 항목은 C: 가 없는 개발 머신에서 체크아웃 자체가 런타임 루트일 때를 위한 것.
llm_environment/
/environment/
/models/
/logs/
/users/

# ─────────────────────────────────────────────
#  체크아웃 내부 사용자 데이터는 항상 런타임 산출물
# ─────────────────────────────────────────────
/user_data/
/src/user_data/
.webui_secret_key

# ─────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
.env/
dist/
build/
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt
*.whl

# ─────────────────────────────────────────────
#  로그 / 임시 / 캐시
# ─────────────────────────────────────────────
*.log
logs/
*.tmp
*.cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# ─────────────────────────────────────────────
#  운영체제
# ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
*~
.Trash-*

# ─────────────────────────────────────────────
