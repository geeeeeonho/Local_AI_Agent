# =========================================================
#  LLM 로컬 환경 — Git 무시 목록
#  민감 정보·대용량 파일·로그·캐시를 저장소에서 제외합니다.
# =========================================================

# ─────────────────────────────────────────────
#  설치된 환경 전체 (대용량 + 사용자별)
# ─────────────────────────────────────────────
# 14GB+ 의 모델 데이터, 컨테이너, venv 등
# 코드만 저장소에 두고 환경은 `python -m installer` 로 재생성
llm_environment/

# ─────────────────────────────────────────────
#  개인 설정 / 레거시 호환 경로
# ─────────────────────────────────────────────
# 정본은 user_data/settings/user_config.json.
# launcher/settings 와 launcher/agent/settings 는 settings_store 가
# user_data/settings 로 연결하는 호환 링크이므로 저장소에는 기록하지 않는다.
/launcher/settings/
/launcher/agent/settings/
.webui_secret_key

# ─────────────────────────────────────────────
#  통합 사용자 데이터 (user_data/)
# ─────────────────────────────────────────────
/user_data/*
!/user_data/.gitkeep
!/user_data/README
!/user_data/README.*

# ─────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
.env/
dist/
build/
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt
*.whl

# ─────────────────────────────────────────────
#  로그 / 임시 / 캐시
# ─────────────────────────────────────────────
*.log
logs/
*.tmp
*.cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────
#  운영체제
# ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
*~
.Trash-*

# ─────────────────────────────────────────────
#  IDE / 에디터
# ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─────────────────────────────────────────────
#  환경변수 / 비밀
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
secrets.yaml
credentials.json

# ─────────────────────────────────────────────
#  모델 / 데이터 파일 (대용량)
# ─────────────────────────────────────────────
*.gguf
*.safetensors
*.bin
*.pth
*.pt
*.ckpt
*.h5
*.onnx
manifests/
blobs/

# ─────────────────────────────────────────────
#  Docker
# ─────────────────────────────────────────────
.docker/

# ─────────────────────────────────────────────
#  사용자 작업 데이터
# ─────────────────────────────────────────────
agent/workspace/*
!agent/workspace/.gitkeep
!agent/workspace/README.txt
chat_ui/data/
*.db
*.sqlite
*.sqlite3

# ─────────────────────────────────────────────
#  경로 통합 이전 잔재 + 런타임 산출물
# ─────────────────────────────────────────────
/launcher/user_data/
session_*.json
!**/.gitkeep
mcp_tools.json
.path_unify_manifest.json
**/interpreter/sandbox/PreTool/
